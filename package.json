{
  "name": "zuz-tcc",
  "version": "1.0.0",
  "private": true,
  "description": "ZUZ - Precificação inteligente para pequenos negócios",
  "main": "local-server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env local-server.js",
    "dev": "node --env-file-if-exists=.env --watch local-server.js",
    "test:core": "node scripts/sync-browser-vendor.js --check && node --test tests/*.test.js",
    "vendor:sync": "node scripts/sync-browser-vendor.js",
    "market:import": "node --env-file-if-exists=.env scripts/import-compras-catalog.js",
    "market:sync": "node --env-file-if-exists=.env scripts/sync-market-prices.js",
    "market:catalog-seed": "node --env-file-if-exists=.env scripts/bootstrap-open-facts.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "ml-regression": "^6.3.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
