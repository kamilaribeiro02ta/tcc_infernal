# SQLite continua sendo usado no desenvolvimento local.
PORT=3000
NODE_ENV=development
# Obrigatório na Vercel (Neon PostgreSQL):
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# API comercial opcional. Nunca enviar tokens ao navegador ou ao Git.
ZUZ_BDC_ENABLED=false
ZUZ_BDC_TERMS_ACCEPTED=false
# BDC_ACCESS_TOKEN=
# BDC_TOKEN_ID=
# Caminhos reais confirmados em uma resposta autorizada da conta (notação ponto).
# Nome: relativo ao produto; URL: relativo à fonte/vendedor do preço.
# BDC_PRODUCT_NAME_PATH=
# BDC_SOURCE_URL_PATH=

# Exclusivo de testes: PostgreSQL descartável local, nunca produção.
# ZUZ_TEST_DATABASE_URL=postgresql://zuz_test:ci_only_disposable@localhost:5432/zuz_test

# Teste IA (Google Gemini) — configure apenas no backend/Vercel
GEMINI_API_KEY=
